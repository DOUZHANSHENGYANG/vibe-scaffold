{
  "name": "vibe-scaffold-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "deps": "node packages/integrations/scripts/deps.ts",
    "knip": "knip",
    "stacks": "node packages/integrations/scripts/stacks.ts",
    "ready": "vp check && vp run knip && vp test",
    "prepare": "vp config",
    "cli": "vp run --filter @douzhanshengyang/vibe-scaffold-cli build && node apps/cli/dist/cli.mjs"
  },
  "devDependencies": {
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "@vibe-scaffold/config": "workspace:*",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.22.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.17.0",
    "pnpm": ">=11.22.0"
  }
}
