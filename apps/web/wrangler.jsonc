{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-scaffold",
  "compatibility_date": "2026-10-04",
  // Routes, not custom domains: each host's DNS record is an unproxied CNAME to a preferred
  // Cloudflare hostname, which a custom domain would replace with a proxied one.
  "routes": [
    { "pattern": "vibe-scaffold.dev/*", "zone_name": "vibe-scaffold.dev" },
    { "pattern": "www.vibe-scaffold.dev/*", "zone_name": "vibe-scaffold.dev" },
  ],
  // Non-production branches deploy with `wrangler preview`, which requires this block.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
